ADMIN_EMAIL=
GOOGLE_CLIENT_ID=
OWNER_WHATSAPP=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Transactional email (server secrets, configure on BOTH Workers)
RESEND_API_KEY=
# For owner-only test alerts use onboarding@resend.dev and EMAIL_MODE=admin_only.
# Customer delivery needs a verified sender domain; never use a gmail.com From address.
EMAIL_FROM=

# admin_only sends only admin-request jobs to ADMIN_EMAIL, leaving customer mail on hold.
EMAIL_MODE=all

# Optional Google MailApp relay for customer emails without a sender domain.
# URL is the signed-POST-only Apps Script web app; secret must be encrypted.
EMAIL_CUSTOMER_PROVIDER=
GMAIL_RELAY_URL=
GMAIL_RELAY_SECRET=
